define slug(s: String) -> String {
    out := ""
    prev_dash := true

    for c in s {
        if c.is_alpha() or c.is_digit() {
            out += c.lower()
            prev_dash = false
        } elif not prev_dash {
            out += "-"
            prev_dash = true
        }
    }

    if out.endswith("-") {
        out = out.substring(0, out.length() - 1)
    }
    return out
}
